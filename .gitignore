# Datasets and model weights: large, re-downloadable, never in git.
data/
outputs/
.cache/
wandb/

# Weights and serialised state, wherever they land. outputs/ covers the normal
# case; these catch a checkpoint written somewhere unexpected.
*.pth
*.pt
*.pkl
*.ckpt
*.onnx
*.safetensors

# Imagery. The 26 GB of SN2 tiles live under data/, but a stray GeoTIFF written
# to the repo root would be both large and CC BY-SA licensed material that must
# carry attribution. No .tif is ever a source file in this project.
*.tif
*.tiff

# Credentials. `wandb login` writes $HOME/.netrc and run.sh mounts it in, so
# none of this belongs in the tree -- but an accidental copy must not be
# committable either.
.netrc
.env
.env.*
*.key
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.ipynb_checkpoints/

# Vendored wheels for the host-side doc tools (cp311, unpacked).
.pylibs

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Office / editor lock and temp files. An ONLYOFFICE lock file reached a
# commit on 2026-08-30 carrying username, hostname and a local path.
# NOTE: the backup-file rule is `*~`, not `~`. A bare `~` matches only a file
# literally named "~" and let every editor backup through.
.~lock.*#
*~
*.tmp

# Generated figures. Scripts write into the repo-root figures/ directory; only
# the copies referenced by a post are tracked, under posts/figures/.
# NOTE: this rule is anchored with a leading slash on purpose. Unanchored,
# `figures/` matches a directory of that name at ANY depth, which silently
# ignored posts/figures/ too -- so a newly added figure would never have been
# committed and the post would render with a missing image. outputs/figures/
# is already covered by outputs/ above.
/figures/

# Intermediate drafts of posts. Only the current version of each post is
# tracked; earlier drafts stay on disk and in git history. Add the current one
# explicitly with `git add -f`.
# NOTE: the version class is `[0-9]*`, not `[2-9]`. The old rule stopped
# matching at v9, so v10 was tracked by accident rather than by decision.
posts/*v[0-9]*.md
posts/*v[0-9]*.html
posts/*v[0-9]*.docx
